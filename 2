import numpy as np

A = np.array([[4, 7],
              [2, 6]])

transpose = A.T
determinant = np.linalg.det(A)
inverse = np.linalg.inv(A)

print("Original Matrix:")
print(A)

print("\nTranspose of Matrix:")
print(transpose)

print("\nDeterminant:")
print(determinant)

print("\nInverse of Matrix:")
print(inverse)
