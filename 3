import numpy as np

A = np.array([[2, 1],
              [1, 3]])

B = np.array([5, 6])

solution = np.linalg.solve(A, B)

print("Coefficient Matrix:")
print(A)

print("\nConstant Vector:")
print(B)

print("\nSolution:")
print("x =", solution[0])
print("y =", solution[1])

print("\nVerification:")
print("Equation 1:", 2 * solution[0] + solution[1])
print("Equation 2:", solution[0] + 3 * solution[1])
